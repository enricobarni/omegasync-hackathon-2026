# OmegaSync — variáveis de ambiente (exemplo). Copie para `.env.local`.
# NUNCA versione segredos reais. Apenas placeholders aqui.

# --- Integração MCP Logcomex (server-side) ---------------------------------
# Endpoint MCP entregue pela plataforma do projeto.
LOGCOMEX_MCP_URL=https://mcp.logcomex.ai/

# Timeout de uma chamada de tool (ms).
LOGCOMEX_MCP_TIMEOUT_MS=90000
# Intervalo de polling de get_task_status para execução assíncrona (ms).
LOGCOMEX_MCP_POLL_INTERVAL_MS=5000
# Timeout total do polling assíncrono (ms).
LOGCOMEX_MCP_POLL_TIMEOUT_MS=120000

# OPCIONAL — token Bearer OAuth estático para os AGENTES DA EMPRESA
# (list_agents / chat_with_agent, escopo mcp:chat:agents). Normalmente NÃO é
# necessário: o fluxo OAuth interativo (botão "Conectar Logcomex") obtém o token
# e o mantém em sessão server-side. Sem token e sem sessão, o chat usa o agente
# PÚBLICO (chat_free). Nunca comitar o valor.
# LOGCOMEX_MCP_ACCESS_TOKEN=

# OPCIONAL — id do agente da empresa preferido (descoberto via list_agents).
# LOGCOMEX_MCP_AGENT_ID=

# OPCIONAL — nome do agente da empresa a selecionar explicitamente após o login
# (padrão: "Agente PortoHackSantos26-GP07"). Nunca escolher outro cegamente.
# LOGCOMEX_MCP_AGENT_NAME=Agente PortoHackSantos26-GP07

# --- OAuth 2.0 do agente da empresa (server-side) --------------------------
# Escopo solicitado no fluxo OAuth. A discovery do servidor tem precedência; este
# é apenas o fallback documentado (FONTES.md §34).
# LOGCOMEX_OAUTH_SCOPE=mcp:chat:free mcp:chat:agents offline_access

# OPCIONAL — força o redirect_uri do callback e a base do app. Útil atrás de
# proxy/HTTPS. Por padrão são derivados da própria requisição.
# OMEGASYNC_BASE_URL=https://seuapp.exemplo
# LOGCOMEX_OAUTH_REDIRECT_URI=https://seuapp.exemplo/api/logcomex/auth/callback
